# IBM Cloud API Key (optional)
# Used to authenticate with IBM Cloud IAM and access protected MCP servers
# Get your API key from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Database Configuration (optional - for --use-db mode)
# If you want to fetch server list from database instead of hardcoded list
MCP_DATABASE_HOST=your_postgres_host_here
MCP_DATABASE_TYPE=postgres
MCP_DATABASE_PORT=5432
MCP_DATABASE_NAME=mcp_servers
MCP_DATABASE_USER=postgres
MCP_DATABASE_PASSWORD=your_database_password_here
MCP_DATABASE_TABLE_NAME=mcp_servers


# Note: The script can run in two modes:
# 1. Default mode: Uses hardcoded server list (no database needed)
# 2. Database mode: Fetches servers from PostgreSQL (requires --use-db flag and psycopg2)
