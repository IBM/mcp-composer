# Local development image (generic Python, no private registries).
#   docker build -f Dockerfile.local -t mcp-composer:dev .

ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 --shell /usr/sbin/nologin appuser

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY . .

ENV UV_LINK_MODE=copy
ENV PYTHONPATH=/app/src
ENV UV_CACHE_DIR=/tmp/.cache/uv
ENV MCP_MODE=http

RUN uv sync --locked --no-install-project --no-dev \
    && chown -R appuser:appuser /app

USER 1001
EXPOSE 9000

CMD ["uv", "run", "--no-project", "mcp-composer", "run", "--mode", "http", "--host", "127.0.0.1", "--port", "9000"]
