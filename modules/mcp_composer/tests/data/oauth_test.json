[
  {
    "id": "example-oauth-service",
    "type": "openapi",
    "open_api": {
      "endpoint": "https://api.example.com/",
      "spec_filepath": "./tests/specs/example_table_api_spec.json",
      "custom_routes": [
        {
          "methods": [
            "GET"
          ],
          "pattern": ".*/.*",
          "mcp_type": "TOOL"
        },
        {
          "methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "pattern": ".*/",
          "mcp_type": "EXCLUDE"
        }
      ]
    },
    "auth_strategy": "oauth2",
    "auth": {
      "clientId": "ENV_OAUTH_CLIENT_ID",
      "clientSecret": "ENV_OAUTH_CLIENT_SECRET",
      "refreshToken": "ENV_OAUTH_REFRESH_TOKEN",
      "token_url": "https://api.example.com/oauth_token",
      "scope": "read"
    },
    "_id": "example-oauth-service"
  }
]
