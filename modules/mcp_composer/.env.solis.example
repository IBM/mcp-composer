# Solis Composer JWT Authentication Configuration
# Copy this file to .env.solis and update with your values

# ============================================================================
# MCP Server Mode
# ============================================================================
# Options: http, sse, stdio
MCP_MODE=sse

# ============================================================================
# JWT Authentication Configuration
# ============================================================================
# Priority order: SOLIS_JWT_SECRET → Full env config

# Option 1: Direct PEM/Key Content (RECOMMENDED)
# Paste your entire PEM file content or public key directly here
# Supports: PEM format, JSON format, or raw key strings
# Example for PEM:
# SOLIS_JWT_SECRET=-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# -----END PUBLIC KEY-----
#
# Example for JSON:
# SOLIS_JWT_SECRET={"public_key": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
#
SOLIS_JWT_SECRET=

# Option 2: Inline public key (alternative to SOLIS_JWT_SECRET)
# SOLIS_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----

# JWT Algorithm
# Options: HS256, HS384, HS512 (HMAC), RS256, RS384, RS512 (RSA), ES256, ES384, ES512 (ECDSA)
SOLIS_JWT_ALGORITHM=HS256

# Expected token issuer (iss claim)
# Set this to your authentication service URL
SOLIS_JWT_ISSUER=https://solis.ibm.com

# Expected token audience (aud claim)
# Set this to your API identifier
SOLIS_JWT_AUDIENCE=solis-api

# Verification Options
# Verify token expiration (recommended: true)
SOLIS_JWT_VERIFY_EXP=true

# Verify token issuer (recommended: true for production)
SOLIS_JWT_VERIFY_ISS=true

# Verify token audience (recommended: true for production)
SOLIS_JWT_VERIFY_AUD=true

# Verify token signature (recommended: true)
SOLIS_JWT_VERIFY_SIGNATURE=true

# Token Extraction
# HTTP header containing JWT token
SOLIS_JWT_HEADER_NAME=Authorization

# Token prefix in header
SOLIS_JWT_HEADER_PREFIX=Bearer

# Required Claims (comma-separated)
# Ensure these claims are present in the JWT
SOLIS_JWT_REQUIRED_CLAIMS=sub,role,tenant

# Leeway for time-based validation (in seconds)
# Allows for clock skew between systems
SOLIS_JWT_LEEWAY=30

# ============================================================================
# Development vs Production Settings
# ============================================================================

# Development (relaxed validation)
# SOLIS_JWT_SECRET=dev-secret-change-in-production
# SOLIS_JWT_ALGORITHM=HS256
# SOLIS_JWT_VERIFY_EXP=false
# SOLIS_JWT_VERIFY_ISS=false
# SOLIS_JWT_VERIFY_AUD=false

# Production (strict validation)
# SOLIS_JWT_SECRET=${VAULT_SOLIS_JWT_SECRET}
# SOLIS_JWT_ALGORITHM=RS256
# SOLIS_JWT_PUBLIC_KEY=${VAULT_SOLIS_PUBLIC_KEY}
# SOLIS_JWT_ISSUER=https://solis.ibm.com
# SOLIS_JWT_AUDIENCE=solis-api
# SOLIS_JWT_VERIFY_EXP=true
# SOLIS_JWT_VERIFY_ISS=true
# SOLIS_JWT_VERIFY_AUD=true

# ============================================================================
# Example JWT Token Structure
# ============================================================================
# {
#   "sub": "user@ibm.com",           # User identifier
#   "name": "John Doe",               # User name
#   "role": "researcher",             # User role
#   "tenant": "ibm-research",         # Tenant/organization
#   "permissions": [                  # User permissions
#     "document:read",
#     "document:search"
#   ],
#   "iss": "https://solis.ibm.com",  # Issuer
#   "aud": "solis-api",               # Audience
#   "exp": 1705334400,                # Expiration timestamp
#   "iat": 1705330800                 # Issued at timestamp
# }