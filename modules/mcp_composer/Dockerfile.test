ARG BUILDER_IMAGE=icr.io/ibm-dreadnought-prod-images/ubi9/python312-builder
ARG DREADNOUGHT_PYTHON312_TAG=SET_VALID_TAG

FROM ${BUILDER_IMAGE}:${DREADNOUGHT_PYTHON312_TAG}

ENV ENABLE_PACKAGE_MANAGER=true

USER root

RUN dnf install -y \
    gcc-c++ \
    python3.12 \
    python3.12-devel \
    python3-devel \
    git \
    && g++ --version

RUN dnf clean all && rm -rf /var/cache/dnf /tmp/*

RUN find / -name Python.h || true

ENV CXXFLAGS="-std=c++11"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

RUN mkdir -p /app && chmod -R 0777 /app
RUN mkdir -p /.cache/uv && chmod -R 0777 /.cache/uv

COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev

COPY . /app

RUN chmod -R 0777 /app

# Initialize git repository for dynamic versioning (same as main Dockerfile)
RUN git init && \
    git config user.email "test@example.com" && \
    git config user.name "Test User" && \
    git add . && \
    git commit -m "Initial commit for testing"

# Install dev dependencies for testing (pytest needs this)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

ENV PATH="/app/.venv/bin:$PATH"
ENV UV_CACHE_DIR=/.cache/uv

ENV PYTHONPATH=/app/src

# Default command runs tests (can be overridden)
CMD ["uv", "run", "pytest", "tests/unit/", "-v", "--tb=short"]
