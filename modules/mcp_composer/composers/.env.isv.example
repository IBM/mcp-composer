# ISV Token Authentication Configuration for Solis Composer
# Copy this file to .env and configure for your environment

# ============================================================================
# ISV Authentication Settings
# ============================================================================

# Deployment environment (determines cookie name and ISV endpoint URL)
# Options: test, dev, prod
# - test: Cookie 'mcsp-glb-iam-test', URL 'https://aws.login.test.saas.ibm.com/...'
# - dev: Cookie 'mcsp-glb-iam-dev', URL 'https://aws.login.dev.saas.ibm.com/...'
# - prod: Cookie 'mcsp-glb-iam', URL 'https://aws.login.prod.saas.ibm.com/...'
ISV_ENVIRONMENT=test

# Enable token caching to reduce ISV API calls
# When enabled, valid tokens are cached until expiration
ISV_CACHE_ENABLED=true

# Cache time-to-live in seconds (default: 7200 = 2 hours)
# Tokens are cached for the minimum of this value and the expires_in from ISV
ISV_CACHE_TTL=7200

# HTTP request timeout in seconds for ISV endpoint calls
ISV_REQUEST_TIMEOUT=30

# ============================================================================
# Optional: Custom Configuration Overrides
# ============================================================================

# Override the cookie name (if not set, auto-determined by ISV_ENVIRONMENT)
# Default values:
#   test: mcsp-glb-iam-test
#   dev:  mcsp-glb-iam-dev
#   prod: mcsp-glb-iam
# Uncomment to use a custom cookie name:
# ISV_COOKIE_NAME=my-custom-cookie-name

# Override the ISV endpoint URL (if not set, auto-determined by ISV_ENVIRONMENT)
# Default values:
#   test: https://aws.login.test.saas.ibm.com/security/auth/isv/token
#   dev:  https://aws.login.dev.saas.ibm.com/security/auth/isv/token
#   prod: https://aws.login.prod.saas.ibm.com/security/auth/isv/token
# Uncomment to use a custom endpoint:
# ISV_ENDPOINT_URL=https://custom-endpoint.example.com/auth/token

# ============================================================================
# MCP Server Configuration
# ============================================================================

# Server transport mode
# Options: http, sse, stdio
MCP_MODE=sse

# ============================================================================
# Notes
# ============================================================================
#
# Configuration Priority (highest to lowest):
#   1. Environment variables (ISV_COOKIE_NAME, ISV_ENDPOINT_URL)
#   2. Auto-determined values based on ISV_ENVIRONMENT
#
# Authentication Flow:
#   1. Extract platform session cookie and grant_type from request headers
#   2. Check cache for valid ISV token
#   3. If not cached, exchange cookie for ISV token via POST to endpoint
#   4. Cache token and return to client
#
# Error Responses:
#   401: Missing or invalid cookie/grant_type
#   403: ISV authentication failed
#   503: ISV service unavailable