{
  "settingsInheritedFrom": "whitesource-config/whitesource-config@master",
  "scanSettingsSAST": {
    "enableScan": true
  },
  "checkRunSettings": {
    "useMendCheckNames": true
  },
  "issueSettingsSAST": {
    "issueType": "finding",
    "minSeverityLevel": "low"
  },
  "checkRunSettingsSAST": {
    "checkRunConclusionLevel": "failure",
    "severityThreshold": "high"
  },
  "remediateSettings": {
    "enableRenovate": true,
    "extends": ["local>ibm-saas-platform/mend-renovate-config:commonRenovateConfig"],
    "workflowRules": {
      "enabled": true
    }
  }
}
