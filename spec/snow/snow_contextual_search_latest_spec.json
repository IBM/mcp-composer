  "paths": {
    "/api/now/cxs/search": {
      "get": {
        "description": "The search context, either sys_id or name",
        "operationId": "search _context_by_name_or_sys_id",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "description": "The index of the first result to return",
            "required": false,
            "schema": {},
            "example": "1"
          },
          {
            "name": "cx",
            "in": "query",
            "description": "The search context, either sys_id or name",
            "required": false,
            "schema": {},
            "example": "Incident Deflection"
          },
          {
            "name": "num",
            "in": "query",
            "description": "The number of resuts to return",
            "required": false,
            "schema": {},
            "example": "10"
          },
          {
            "name": "q",
            "in": "query",
            "description": "Query String",
            "required": false,
            "schema": {},
            "example": "this AND that"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "post": {
        "description": "Performs a context-aware search across knowledge, incidents, or catalog items using a natural language query.",
        "operationId": "search_context",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Query String",
            "required": false,
            "schema": {},
            "example": "Find all incidents where users reported intermittent login failures to VPN after 9 PM"
          },
          {
            "name": "cx",
            "in": "query",
            "description": "The search context, either sys_id or name",
            "required": false,
            "schema": {},
            "example": "Incident Deflection"
          },
          {
            "name": "start",
            "in": "query",
            "description": "The index of the first result to return",
            "required": false,
            "schema": {},
            "example": "1"
          },
          {
            "name": "num",
            "in": "query",
            "description": "The number of resuts to return",
            "required": false,
            "schema": {},
            "example": "10"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {}
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {}
            }
          }
        }
