### ignore all ###
/*

# Re-include modules directory for CRA builds from repo root
!/modules/
!/modules/mcp_composer/

# Re-include core files at root level (if they exist)
!/uv.lock
!/pyproject.toml
!/src/
!/config/
!/example
!/spec
!/composers
!Dockerfile
!Dockerfile.*

### ignore final ###
__pycache__
*.egg-info
*.pyc
.pytest_cache/
.coverage

### metafiles ###
.DS_Store
__MACOSX
