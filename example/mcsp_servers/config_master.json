[
  {
    "id": "mcp-wxok",
    "type": "openapi",
    "open_api": {
      "endpoint": "https://api.dl.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/",
      "spec_filepath": "./src/mcp-composer/spec/wxo-openapi-spec.json",
      "custom_routes": [
        {
          "methods": [
            "GET"
          ],
          "pattern": ".*/.*",
          "mcp_type": "TOOL"
        },
        {
          "methods": [
            "POST",
            "DELETE",
            "PUT",
            "PATCH"
          ],
          "pattern": ".*",
          "mcp_type": "EXCLUDE"
        }
      ]
    },
    "auth_strategy": "dynamic_bearer",
    "auth": {
      "apikey": "<edit-me>",
      "token_url": "https://iam.platform.saas.ibm.com/siusermgr/api/1.0/apikeys/token",
      "media_type": "json"
    },
    "_id": "mcp-wxok"
  },
  {
    "id": "mcp-eventbrite",
    "type": "openapi",
    "open_api": {
      "endpoint": "https://www.eventbriteapi.com/v3",
      "spec_filepath": "./src/mcp-composer/spec/eventbrite-openapi.json",
      "custom_routes": [
        {
          "methods": [
            "GET"
          ],
          "pattern": ".*/users/.*",
          "mcp_type": "RESOURCE_TEMPLATE"
        },
        {
          "methods": [
            "GET"
          ],
          "pattern": ".*/events/.*",
          "mcp_type": "TOOL"
        },
        {
          "methods": [
            "POST"
          ],
          "pattern": ".*/",
          "mcp_type": "EXCLUDE"
        }
      ]
    },
    "auth_strategy": "bearer",
    "auth": {
      "token": "<edit-me>"
    }
  },
  {
    "id": "mcp-stock-info",
    "type": "http",
    "endpoint": "https://mcp-stock-info.<ce-subdomain>.<ce-region>.codeengine.appdomain.cloud/mcp"
  },
  {
    "id": "mcp-countries",
    "type": "graphql",
    "graphql": {
      "endpoint": "https://countries.trevorblades.com/",
      "schema_filepath": "./src/mcp-composer/example/graphql-to-mcp/countries.graphql"
    },
    "_id": "mcp-countries"
  },
  {
    "id": "mcp-pokemon",
    "type": "graphql",
    "graphql": {
      "endpoint": "https://graphqlpokemon.favware.tech/v8",
      "schema_filepath": "./src/mcp-composer/example/graphql-to-mcp/pokemon.graphql"
    },
    "_id": "mcp-pokemon"
  },
  {
  "id": "mcp-server-fetch",
  "type": "sse",
  "endpoint": "https://mcp-server-fetch.<edit-me>.eu-es.codeengine.appdomain.cloud/sse"
 },

{
    "id": "snow-search",
    "type": "openapi",
    "open_api": {
      "endpoint": "https://<edit-me>.service-now.com/",
      "spec_filepath": "./src/mcp-composer/spec/snow/snow_table_api_latest_spec.json",
      "custom_routes": [
        {
          "methods": [
            "GET"
          ],
          "pattern": ".*/.*",
          "mcp_type": "TOOL"
        },
        {
          "methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "pattern": ".*/",
          "mcp_type": "EXCLUDE"
        }
      ]
    },
    "auth_strategy": "basic",
    "auth": {
      "username": "<edit-me>",
      "password": "<edit-me>"
    },
    "_id": "snow-search"
  }

]