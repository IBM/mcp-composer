{
  "openapi": "3.0.3",
  "info": {
    "title": "Shelf API",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "list_shelf_items",
        "summary": "List items stored on the shelf.",
        "responses": {
          "200": {
            "description": "A list of item names."
          }
        }
      }
    },
    "/items/{item_id}": {
      "delete": {
        "operationId": "remove_shelf_item",
        "summary": "Remove one item from the shelf.",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The item was removed."
          }
        }
      }
    }
  }
}
