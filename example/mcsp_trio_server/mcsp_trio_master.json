[
  {
    "id": "mcp-instana",
    "type": "openapi",
    "open_api": {
      "endpoint": "https://demous-instana.instana.io",
      "spec_filepath": "/app/spec/instana-openapi.json",
      "custom_routes": [
        {
          "methods": ["GET", "POST"],
          "pattern": ".*/application-monitoring/.*",
          "mcp_type": "TOOL"
        },
        {
          "methods": ["PATCH", "PUT", "DELETE"],
          "pattern": ".*/",
          "mcp_type": "EXCLUDE"
        }
      ]
    },
    "auth_strategy": "apikey",
    "auth": {
      "auth_prefix": "apiToken",
      "apikey": "",
      "auth_header_prefix": "Authorization"
    },
    "_id": "mcp-instana"
  }
]
