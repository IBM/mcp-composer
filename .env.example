####### MCP Composer Server env variables

MCP_BASE_URL=http://127.0.0.1:9000/mcp

# Absolute paths allowed to run as stdio member servers (colon- or comma-separated).
# Mounting a stdio server fails closed when this is unset or the command is not listed.
# MCP_COMPOSER_STDIO_ALLOWLIST=/usr/local/bin/uvx

# This server and version config file will be automatically created 
# in the root folder when you register a server.

# SERVER_CONFIG_FILE_PATH=mcp_servers.json
# VERSION_CONFIG_FILE_PATH=versioned_config.json
# MCP_USE_LOCAL_FILE_STORAGE=True
# VERSION_ADAPTER_TYPE=file # 'ibm_vault' if you want to use ibm secret manager

# MCP Composer server transport mode
MCP_MODE=http

# Enable multi-server HTTP routing (disabled by default)
# When enabled, each mounted MCP server gets its own HTTP route (e.g., /server1/, /server2/)
# Set to 'true' to enable multi-server routing, 'false' or omit to disable
# ENABLE_MULTI_SERVER_HTTP_ROUTING=false

# MCP Composer mode can be dev or prod
# MCP_COMPOSER_MODE=dev


# ------ Embedding Configuration for A2A Service --------------
# Provider options: "sentence-transformers" (default, local), "litellm", "ollama"
# EMBEDDING_PROVIDER=sentence-transformers

# For litellm, specify the model provider (e.g., "openai", "azure", "gemini") and model name (e.g., "text-embedding-3-small" for OpenAI, "gemini-embedding-001" for Gemini)
# EMBEDDING_MODEL_PROVIDER=google

# Model name (provider-specific):
# - For sentence-transformers: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
# - For litellm: text-embedding-ada-002, text-embedding-3-small, etc.
# - For ollama: nomic-embed-text, mxbai-embed-large, etc.
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# API key for embedding provider (required for litellm with OpenAI/Azure)
# EMBEDDING_API_KEY=your-api-key-here

# Base URL for embedding provider (required for ollama, optional for litellm)
# EMBEDDING_BASE_URL=http://localhost:11434



# by default oauth disabled
ENABLE_OAUTH=False

# ------ Github OAuth configuration ------
OAUTH_PROVIDER = "github"
OAUTH_BASE_URL=http://localhost:9000
OAUTH_CLIENT_ID=xxxxxxx
OAUTH_CLIENT_SECRET=xxxxxxx

# ------ Generic OIDC provider (optional) ------
# OAUTH_PROVIDER=oidc
# OAUTH_CLIENT_ID=xxxxxxx
# OAUTH_CLIENT_SECRET=xxxxxxxx
# OAUTH_BASE_URL=http://127.0.0.1:9000
# OAUTH_CONFIG_URL=https://example.com/.well-known/openid-configuration
# OAUTH_AUTH_URL=https://example.com/authorize
# OAUTH_TOKEN_URL=https://example.com/token
# OAUTH_PROVIDER_SCOPE=openid

####### Optional model-provider settings
# WATSONX_CHAT_MODEL=ibm/granite-3-3-8b-instruct
# WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# WATSONX_API_KEY=<edit-me>
# WATSONX_PROJECT_ID=<edit-me>
# OLLAMA_CHAT_MODEL=<edit-me>

# ollama model (must exist in local ollama models)
# e.g., granite3.3:8b
# OLLAMA_CHAT_MODEL=<edit-me>


#### Open telemetry 
# MCP_TRACING_ENABLED=true
# MCP_TRACING_PROTOCOL=http
# OTEL_SERVICE_NAME=mcp-composer
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# MCP_METRICS_ENABLED=true
# MCP_ENV=dev

# Enable multi-server HTTP routing (disabled by default)
# When enabled, each mounted MCP server gets its own HTTP route (e.g., /server1/, /server2/)
# Set to 'true' to enable multi-server routing, 'false' or omit to disable
# ENABLE_MULTI_SERVER_HTTP_ROUTING=false