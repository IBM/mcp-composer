FROM icr.io/ibm-dreadnought-prod-images/ubi9/nodejs20-builder:v9.6.49 as node-deps

RUN npm install -g @ivotoby/openapi-mcp-server

FROM icr.io/ibm-dreadnought-prod-images/ubi9/python312-builder:v9.6.27 as builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev

COPY . /app

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

